# Use lightweight standard Python image (No CUDA)
FROM python:3.12-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    UV_FROZEN=1

# Install curl and git (needed for uv download/vcs dependencies)
RUN apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates && rm -rf /var/lib/apt/lists/*

# Install uv (blazing fast rust-based package manager)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uv/bin/uv
ENV PATH="/uv/bin:$PATH"

WORKDIR /app

# Copy dependency files
COPY pyproject.toml .
COPY uv.lock .

# Configure uv for Docker and caching
ENV UV_LINK_MODE=hardlink \
    UV_COMPILE_BYTECODE=1

# Install the CPU gateway dependencies plus the Kubernetes client used by the
# cluster worker launcher. Keep the massive ML extras out of this image.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --extra cluster

# Copy source code
COPY . .

# Expose source code via PYTHONPATH instead of modifying .venv after COPY . .
ENV PYTHONPATH="/app/src:/app:$PYTHONPATH"

EXPOSE 8000

# Start the Gateway
CMD ["uv", "run", "uvicorn", "server.gateway:app", "--host", "0.0.0.0", "--port", "8000"]
