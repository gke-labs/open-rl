# syntax=docker/dockerfile:1

# TPU trainer image. Same layout as src/server/Dockerfile, with no CUDA: a
# plain Ubuntu base and the `tpu` extra (torch-tpu and CPU torch from PyPI)
# instead of `gpu` + `vllm`.

FROM ubuntu:22.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    UV_FROZEN=1

# git fetches the `cluster` extra's git dependency. Everything installs from
# wheels, so no compiler.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uv/bin/uv
ENV PATH="/uv/bin:$PATH"

# Install Python 3.12 via uv
RUN uv python install 3.12

WORKDIR /app

# Copy dependency files
COPY pyproject.toml .
COPY uv.lock .

# Same uv settings as src/server/Dockerfile.
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_SYNC=1

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --extra tpu --extra cluster

# Copy source code
COPY . .

# Install the project.
RUN uv sync --frozen --extra tpu --extra cluster

# The venv is on PATH so a job that names this image as its trainer runs
# `python -u -m server.training_requests_processor` like any other image.
# TORCH_DEVICE_BACKEND_AUTOLOAD stays unset: torch_tpu only registers its
# device with autoload on.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src:/app:$PYTHONPATH" \
    OPEN_RL_DEVICE=tpu

CMD ["uv", "run", "python", "-u", "-m", "server.training_requests_processor"]
