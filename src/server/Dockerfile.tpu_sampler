# syntax=docker/dockerfile:1
# check=skip=FromPlatformFlagConstDisallowed

# TPU sampler image. Same layout as src/server/Dockerfile.tpu, with the
# `tpu-sampler` extra (vllm-tpu, which brings tpu-inference, JAX and libtpu)
# instead of `tpu`. No torch_tpu wheel: the sampler reaches the TPU through JAX.
# Pinned to linux/amd64 because the `tpu-sampler` extra installs nothing on
# other platforms.

FROM --platform=linux/amd64 ubuntu:22.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    UV_FROZEN=1

# git fetches the `cluster` extra's git dependency. Everything installs from
# wheels, so no compiler.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uv/bin/uv
ENV PATH="/uv/bin:$PATH"

# Install Python 3.12 via uv
RUN uv python install 3.12

WORKDIR /app

# Copy dependency files
COPY pyproject.toml .
COPY uv.lock .

# Same uv settings as src/server/Dockerfile. UV_NO_SYNC keeps `uv run` from
# syncing at start, which would drop the extras.
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_SYNC=1

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --extra tpu-sampler --extra cluster

# Only src/: the sampler needs nothing else from the repo. The project is not
# installed, so the delta-sync vLLM plugin (FFT only) is not registered;
# PYTHONPATH below exposes the source.
COPY src src

# MODEL_IMPL_TYPE=vllm: tpu-inference has LoRA only on its vLLM model path, and
# would otherwise pick its JAX path for models such as Qwen.
# TORCH_DEVICE_BACKEND_AUTOLOAD=0: if torch_tpu is ever installed, keeps it from
# claiming every chip on `import torch`.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app/src \
    MODEL_IMPL_TYPE=vllm \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0

CMD ["uv", "run", "python", "-u", "-m", "server.vllm_sampler"]
