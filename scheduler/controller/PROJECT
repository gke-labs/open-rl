# Kubebuilder project metadata.
# https://book.kubebuilder.io/reference/project-config.html
#
# Written by hand rather than by `kubebuilder init`: the tree already existed in
# the kubebuilder layout (api/, cmd/manager, internal/controller, controller-gen
# markers on the types) and this file is what makes the CLI and its plugins
# recognise it, so `kubebuilder create api` and `kubebuilder edit` work here.
#
# One deviation from a stock scaffold: there is no config/ kustomize tree. The
# scheduler deploys from scheduler/deploy, and a second deploy path would be a
# second thing to keep correct. `make manifests` generates the CRDs straight
# into scheduler/deploy/base instead.
domain: openrl.io
layout:
- go.kubebuilder.io/v4
projectName: open-rl-scheduler
repo: github.com/openrl-dev/openrl/scheduler/controller
resources:
- api:
    crdVersion: v1
    namespaced: true
  controller: true
  domain: openrl.io
  kind: Workload
  path: github.com/openrl-dev/openrl/scheduler/controller/api/v1alpha1
  version: v1alpha1
- api:
    crdVersion: v1
    namespaced: true
  domain: openrl.io
  kind: ClaimLedger
  path: github.com/openrl-dev/openrl/scheduler/controller/api/v1alpha1
  version: v1alpha1
version: "3"
